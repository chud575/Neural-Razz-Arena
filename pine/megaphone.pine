//@version=6
// Megaphone – Broadening Formation   ·   v1.3
// Changelog
//  v1.3  Costs: maker/taker fees + funding (default Bybit VIP 3) — table is net of fees; liquidation check at your leverage
//  v1.2  TP1 / TP2 as R multiples, % closed at TP1, optional breakeven after TP1
//  v1.1  Tightening toggles: min expansion (× ATR), swings-on-lines fit, breakout retest entry,
//        measured-move target, failed-breakout fade (+ Failed BO column in the table)
//  v1.0  First version: edge fades (touch / rejection) and breakouts, stats table
//
// Megaphone (broadening formation) indicator with a built-in performance tracker.
// Python twin: python/megaphone_backtest.py (same rules, so the numbers should match).
//
// Pattern: the last N swing points (alternating highs/lows) make HIGHER highs and LOWER lows.
//          Tightening: 6 swings, minimum expansion per swing (% and × ATR), and (5+ swings) a fit
//          filter that requires the older swings to sit on the trendlines.
//          Upper line = through the last two swing highs, lower line = through the last two swing lows.
//          The pattern stays live until a breakout close or until it gets too old.
// Trades (toggle):
//   Fade      price returns to an edge and reverses → trade back into the pattern
//             entry: "Rejection close" (touch the line, close back inside) or "Touch" (limit at the line)
//             stop: beyond the line by X × ATR   target: R:R, midline, or the opposite line
//   Breakout  a bar CLOSES beyond a line by X × ATR → enter at that close, or wait for a RETEST of the line
//             stop: back inside the line by X × ATR   target: R:R or measured move (pattern height)
//   Failed-breakout fade (toggle): after a breakout close, price closes back INSIDE within N bars → fade it;
//             stop beyond the breakout's extreme, target as for fades.
// Exits: TP1 (R multiple) closes a chosen % of the position, the rest rides to TP2 (the target chosen above:
//        R multiple, midline, opposite line or measured move); optional stop to breakeven after TP1.
//        TP1 is pulled back to TP2 if it would be beyond it. After TP1 the remainder is managed from the next bar.
// Simulation (conservative): stop wins if stop and target are touched in the same bar; a limit fill only
// checks its stop on the fill bar; gaps fill at the open; one trade at a time.
indicator("Megaphone – Broadening Formation v1.3", shorttitle = "Megaphone v1.3", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
grpP = "Pattern"
pivLen    = input.int(5, "Swing strength (bars each side)", minval = 1, group = grpP)
minPivots = input.int(4, "Swings required", options = [4, 5, 6], group = grpP,
     tooltip = "4 = two higher highs + two lower lows. 5 = the classic '5-touch' megaphone.")
minExpand = input.float(0.0, "Each new extreme must exceed the last by (%)", minval = 0.0, step = 0.1, group = grpP)
minExpAtr = input.float(0.0, "...and by at least (× ATR)", minval = 0.0, step = 0.05, group = grpP,
     tooltip = "Filters out near-equal swings (a flat range rather than a widening megaphone). 0 = off.")
fitAtr    = input.float(0.0, "Swings must sit on the lines within (× ATR)", minval = 0.0, step = 0.25, group = grpP,
     tooltip = "Needs 5 or 6 swings: the older highs/lows must lie within this distance of the trendlines drawn through the last two. 0 = off.")
maxLen    = input.int(200, "Max pattern length (bars)", minval = 20, maxval = 450, group = grpP)
atrLen    = input.int(14, "ATR length", minval = 1, group = grpP)

grpT = "Trades"
modeIn    = input.string("Fade + Breakout", "Trade mode", options = ["Fade + Breakout", "Fade only", "Breakout only", "None (failed-breakout fade only)"], group = grpT)
fadeEntry = input.string("Rejection close", "Fade entry", options = ["Rejection close", "Touch"], group = grpT)
fadeTgt   = input.string("R:R", "Fade target", options = ["R:R", "Midline", "Opposite line"], group = grpT)
tp1RR     = input.float(1.0, "TP1 (reward : risk)", minval = 0.1, step = 0.1, group = grpT,
     tooltip = "TP1 distance as a multiple of the risk (entry → stop). If it would be beyond TP2 it is pulled back to TP2.")
tp2RR     = input.float(2.0, "TP2 (reward : risk)", minval = 0.1, step = 0.1, group = grpT,
     tooltip = "Final target as a multiple of the risk — used when the fade / breakout target is set to R:R.")
tp1Pct    = input.float(50, "% of position closed at TP1", minval = 0, maxval = 100, step = 5, group = grpT,
     tooltip = "100 = everything exits at TP1 (TP2 unused). 0 = TP1 ignored, everything rides to TP2.")
beOn      = input.bool(true, "Move stop to breakeven after TP1", group = grpT)
p1        = tp1Pct / 100.0

grpC = "Costs (futures)"
feesOn     = input.bool(true, "Include trading fees & funding", group = grpC,
     tooltip = "Results in the table are net of these costs. Entry = taker fee. Exit at a target = maker fee, at a stop / breakeven = taker fee. Funding is charged per 8 hours held (longs pay, shorts receive; negative = the reverse). Defaults: Bybit VIP 3.")
takerPct   = input.float(0.035, "Taker fee (%)", minval = 0.0, step = 0.005, group = grpC)
makerPct   = input.float(0.014, "Maker fee (%)", minval = 0.0, step = 0.005, group = grpC)
funding8h  = input.float(0.01,  "Funding per 8h (%)", step = 0.005, group = grpC)
leverage   = input.float(25, "Leverage (for the liquidation check)", minval = 1, step = 1, group = grpC)
mmrPct     = input.float(0.5, "Maintenance margin rate (%)", minval = 0.0, step = 0.1, group = grpC,
     tooltip = "Isolated margin: liquidation ≈ (100 / leverage − maintenance margin) % against the entry. Trades whose stop is further away than that would be liquidated before the stop.")
liqDistPct = 100.0 / leverage - mmrPct
var int liqCount = 0

// Trading cost of one finished trade, in R (entry taker + exit maker/taker + funding while held)
costR(int d, float ePx, float riskU, bool atTarget, int entryTime) =>
    float hrs = (time - entryTime) / 3600000.0
    float cf  = feesOn ? (takerPct + (atTarget ? makerPct : takerPct) + d * funding8h * hrs / 8.0) / 100.0 : 0.0
    riskU > 0 ? cf * ePx / riskU : 0.0

// Warn when the stop is beyond the liquidation distance at the chosen leverage
liqWarn(float ePx, float stp, int d) =>
    bool risky = math.abs(ePx - stp) / ePx * 100.0 > liqDistPct
    if risky
        label.new(bar_index, ePx, "⚠ stop beyond " + str.tostring(leverage) + "x liquidation", style = d == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(color.orange, 10), textcolor = color.black, size = size.tiny)
    risky
rr        = tp2RR
zoneAtr   = input.float(0.1, "Fade zone inside the line (× ATR)", minval = 0.0, step = 0.05, group = grpT)
stopAtr   = input.float(0.5, "Stop distance from the line (× ATR)", minval = 0.05, step = 0.05, group = grpT)
brkAtr    = input.float(0.2, "Breakout close beyond line (× ATR)", minval = 0.0, step = 0.05, group = grpT)
boEntry   = input.string("Close", "Breakout entry", options = ["Close", "Retest"], group = grpT,
     tooltip = "Close: enter on the breakout close. Retest: limit order back at the broken line (one try within the retest window).")
retestWin = input.int(10, "Retest window (bars)", minval = 1, group = grpT)
boTarget  = input.string("R:R", "Breakout target", options = ["R:R", "Measured move"], group = grpT,
     tooltip = "Measured move = the pattern's height at the breakout, projected from the entry.")
failedBo  = input.bool(false, "Failed-breakout fade", group = grpT,
     tooltip = "After a breakout close, if price closes back inside the megaphone within N bars, fade it. Stop beyond the breakout's extreme; target uses the fade target.")
fbWin     = input.int(5, "Failed-breakout window (bars)", minval = 1, group = grpT)

grpF = "Filters"
tradeLongs  = input.bool(true,  "Longs", group = grpF)
tradeShorts = input.bool(true,  "Shorts", group = grpF)
trendOn     = input.bool(false, "Trend filter (longs above SMA, shorts below)", group = grpF)
trendLen    = input.int(200, "Trend SMA length", minval = 2, group = grpF)

grpV = "Visuals"
showTrades = input.bool(true, "Label entries & exits", group = grpV)
tblPosIn   = input.string("Top right", "Stats table position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpV)
tblSizeIn  = input.string("Small", "Stats table text size", options = ["Tiny", "Small", "Normal"], group = grpV)

doFade = modeIn == "Fade + Breakout" or modeIn == "Fade only"
doBrk  = modeIn == "Fade + Breakout" or modeIn == "Breakout only"
atrV   = ta.atr(atrLen)
smaV   = ta.sma(close, trendLen)

// ─────────────────────── Performance storage ───────────────────────
// index = kind * 2 + (long ? 0 : 1)   kind 0 = edge fade, 1 = breakout, 2 = failed-breakout fade
var array<float> aWins = array.new<float>(6, 0.0)
var array<float> aLoss = array.new<float>(6, 0.0)
var array<float> aSumR = array.new<float>(6, 0.0)
var array<float> aGW   = array.new<float>(6, 0.0)
var array<float> aGL   = array.new<float>(6, 0.0)
var array<float> eq    = array.new<float>(3, 0.0)   // [cum R, peak R, max DD R]
var int patCount = 0

recordExit(int dir, int kind, float r) =>
    int   idx = kind * 2 + (dir == 1 ? 0 : 1)
    if r > 0
        array.set(aWins, idx, array.get(aWins, idx) + 1)
        array.set(aGW,   idx, array.get(aGW, idx) + r)
    else
        array.set(aLoss, idx, array.get(aLoss, idx) + 1)
        array.set(aGL,   idx, array.get(aGL, idx) + math.abs(r))
    array.set(aSumR, idx, array.get(aSumR, idx) + r)
    float cum = array.get(eq, 0) + r
    array.set(eq, 0, cum)
    array.set(eq, 1, math.max(array.get(eq, 1), cum))
    array.set(eq, 2, math.max(array.get(eq, 2), array.get(eq, 1) - cum))
    r

// Advance an open trade by one bar (TP1 / TP2 scale-out).
// Returns [stillOpen, tp1Done, stop, totalR, tp1FillPx (na = none), finalExitPx (na = none), exitTag]
stepEntry(int d, float ePx, float riskU, float stp, float tp1, float tp2, bool done1In, float rIn, bool stopOnly) =>
    bool   op    = true
    bool   done1 = done1In
    float  st    = stp
    float  accR  = rIn
    float  t1Px  = na
    float  xPx   = na
    string tag   = ""
    float  rem   = done1 and p1 > 0 ? 1.0 - p1 : 1.0
    bool stopHit = d == 1 ? low <= st : high >= st
    if stopHit                                            // stop (or breakeven stop) first
        xPx := d == 1 ? math.min(open, st) : math.max(open, st)
        tag := done1 and beOn and p1 > 0 ? "BE" : "SL"
    else if not stopOnly
        if not done1 and (d == 1 ? high >= tp1 : low <= tp1)
            t1Px  := d == 1 ? math.max(open, tp1) : math.min(open, tp1)
            accR  += p1 * d * (t1Px - ePx) / riskU
            done1 := true
            rem   := 1.0 - p1
            if rem <= 0
                op := false                               // everything closed at TP1
            else if beOn
                st := ePx                                 // remainder: stop to breakeven, managed from next bar
        else if done1 and (d == 1 ? high >= tp2 : low <= tp2)
            xPx := d == 1 ? math.max(open, tp2) : math.min(open, tp2)
            tag := "TP2"
    if not na(xPx)
        accR += rem * d * (xPx - ePx) / riskU
        op   := false
    [op, done1, st, accR, t1Px, xPx, tag]

exitLabel(float px, string txt, float r) =>
    if showTrades
        label.new(bar_index, px, txt + " " + (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R",
             style = label.style_label_left, color = r > 0 ? color.new(color.green, 20) : color.new(color.red, 20),
             textcolor = color.white, size = size.tiny)

trendOk(int d) =>
    not trendOn or (not na(smaV) and (d == 1 ? close > smaV : close < smaV))

sideOk(int d) =>
    d == 1 ? tradeLongs : tradeShorts

// ───────────────────────────── Swing sequence ─────────────────────────────
var array<int>   pvT = array.new<int>()     // 1 = high, -1 = low
var array<float> pvP = array.new<float>()
var array<int>   pvB = array.new<int>()

// Append a swing, keeping the sequence alternating (two highs in a row → keep the higher one, etc.)
pushPivot(int tp, float price, int bar) =>
    bool changed = false
    int sz = array.size(pvT)
    if sz > 0 and array.get(pvT, sz - 1) == tp
        float lastP = array.get(pvP, sz - 1)
        if (tp == 1 and price > lastP) or (tp == -1 and price < lastP)
            array.set(pvP, sz - 1, price)
            array.set(pvB, sz - 1, bar)
            changed := true
    else
        array.push(pvT, tp)
        array.push(pvP, price)
        array.push(pvB, bar)
        if array.size(pvT) > 12
            array.shift(pvT)
            array.shift(pvP)
            array.shift(pvB)
        changed := true
    changed

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
bool changed = false
if not na(ph)
    changed := pushPivot(1, ph, bar_index - pivLen) or changed
if not na(pl)
    changed := pushPivot(-1, pl, bar_index - pivLen) or changed

// ───────────────────────────── Pattern state ─────────────────────────────
var bool  patOn   = false
var float pU      = na    // upper line anchor price / bar / slope
var int   bU      = na
var float sU      = na
var float pL      = na
var int   bL      = na
var float sL      = na
var int   pStart  = na
var int   pConf   = na
var line  upLine  = na
var line  loLine  = na
var int   patState = 0    // 0 = live, 1 = broken (waiting for retest / failed breakout)
var int   boDir    = 0
var int   boBar    = na
var float boExt    = na
var float boHeight = na
var bool  retestArmed = false
var bool  fbArmed     = false

if changed and array.size(pvT) >= minPivots
    int   sz  = array.size(pvT)
    bool  ok  = true
    int   nH  = 0
    int   nL  = 0
    float h1P = na
    int   h1B = na
    float h2P = na
    int   h2B = na
    float l1P = na
    int   l1B = na
    float l2P = na
    int   l2B = na
    if (minExpAtr > 0 or fitAtr > 0) and na(atrV)
        ok := false
    for k = sz - minPivots to sz - 1
        int   tp = array.get(pvT, k)
        float pr = array.get(pvP, k)
        int   br = array.get(pvB, k)
        if tp == 1
            if nH > 0 and (pr <= h2P * (1 + minExpand / 100.0) or pr - h2P < minExpAtr * nz(atrV))
                ok := false
            h1P := h2P
            h1B := h2B
            h2P := pr
            h2B := br
            nH += 1
        else
            if nL > 0 and (pr >= l2P * (1 - minExpand / 100.0) or l2P - pr < minExpAtr * nz(atrV))
                ok := false
            l1P := l2P
            l1B := l2B
            l2P := pr
            l2B := br
            nL += 1
    // fit filter: older swings must lie close to the lines through the last two highs / lows
    if ok and nH >= 2 and nL >= 2 and fitAtr > 0
        float fsU = (h2P - h1P) / (h2B - h1B)
        float fsL = (l2P - l1P) / (l2B - l1B)
        for k = sz - minPivots to sz - 1
            int   tp = array.get(pvT, k)
            float pr = array.get(pvP, k)
            int   br = array.get(pvB, k)
            if tp == 1 and br < h1B and math.abs(pr - (h2P + fsU * (br - h2B))) > fitAtr * atrV
                ok := false
            if tp == -1 and br < l1B and math.abs(pr - (l2P + fsL * (br - l2B))) > fitAtr * atrV
                ok := false
    if ok and nH >= 2 and nL >= 2
        patOn  := true
        patState    := 0
        retestArmed := false
        fbArmed     := false
        pU     := h2P
        bU     := h2B
        sU     := (h2P - h1P) / (h2B - h1B)
        pL     := l2P
        bL     := l2B
        sL     := (l2P - l1P) / (l2B - l1B)
        pStart := array.get(pvB, sz - minPivots)
        pConf  := bar_index
        patCount += 1
        upLine := line.new(h1B, h1P, bar_index, pU + sU * (bar_index - bU), color = color.new(color.orange, 0), width = 2)
        loLine := line.new(l1B, l1P, bar_index, pL + sL * (bar_index - bL), color = color.new(color.orange, 0), width = 2)
        label.new(bar_index, pU + sU * (bar_index - bU), "Megaphone", style = label.style_label_down,
             color = color.new(color.orange, 20), textcolor = color.white, size = size.tiny)
        alert("Megaphone detected on " + syminfo.ticker, alert.freq_once_per_bar_close)

// ───────────────────────────── Trade state ─────────────────────────────
var bool  inTr   = false
var int   trD    = 0
var int   trKind = 0
var float trE    = na
var float trS    = na
var float trT    = na      // TP2 (final target)
var float trT1   = na      // TP1
var bool  trDone1 = false
var float trR    = 0.0     // running R of the open trade
var float trRisk = na
var int   trBar  = na
var int   trTime = na

// 1) Manage open trade
bool exited = false
if inTr and bar_index > trBar
    [op, dn, st, ar, t1Fill, xPx, tag] = stepEntry(trD, trE, trRisk, trS, trT1, trT, trDone1, trR, false)
    trDone1 := dn
    trS     := st
    trR     := ar
    if not na(t1Fill) and p1 < 1
        exitLabel(t1Fill, "TP1 " + str.tostring(tp1Pct) + "%", trD * (t1Fill - trE) / trRisk)
    if not op
        trR := trR - costR(trD, trE, trRisk, tag == "" or tag == "TP2", trTime)
        recordExit(trD, trKind, trR)
        exitLabel(na(xPx) ? t1Fill : xPx, (tag == "" ? "TP1" : tag) + " total", trR)
        inTr   := false
        exited := true

// 2) Pattern lines, expiry, fades, breakouts, retests, failed breakouts
// Pending entry ("signal") — filled in by the sections below, then opened by the OPEN block
bool  sOn    = false
int   sD     = 0
int   sKind  = 0
float sE     = na
float sS     = na
float sT     = na
float sRisk  = na
bool  sLimit = false
bool  entered = false

fadeTarget(int d, float ref, float risk, float up, float lo) =>
    fadeTgt == "R:R" ? ref + d * rr * risk : fadeTgt == "Midline" ? (up + lo) / 2.0 : (d == -1 ? lo : up)

if patOn and patState == 0 and bar_index - pStart > maxLen
    patOn := false
bool  haveAtr  = not na(atrV)
float up       = patOn ? pU + sU * (bar_index - bU) : na
float lo       = patOn ? pL + sL * (bar_index - bL) : na
bool  live     = patOn and haveAtr and patState == 0
bool  canEnter = not inTr and not exited          // limit/touch entries: not on a bar where a trade just closed
if patOn
    line.set_xy2(upLine, bar_index, up)
    line.set_xy2(loLine, bar_index, lo)

// 2a) Edge fades — BEFORE the breakout check (a touch limit fills intrabar, before the close is known)
if live and doFade and canEnter and bar_index > pConf
    for side = 0 to 1
        int   d    = side == 0 ? -1 : 1               // short at the top edge, long at the bottom edge
        float ln   = d == -1 ? up : lo
        float edge = ln + d * zoneAtr * atrV
        bool  touched = d == -1 ? high >= edge : low <= edge
        if sideOk(d) and trendOk(d) and touched
            float stp   = ln - d * stopAtr * atrV
            float entry = na
            float ref   = na
            if fadeEntry == "Touch"
                entry := d == -1 ? math.max(open, edge) : math.min(open, edge)
                ref   := edge
            else if (d == -1 ? close < ln : close > ln)
                entry := close
                ref   := close
            if not na(entry) and (ref - stp) * d > 0
                float risk = math.abs(ref - stp)
                float tgt  = fadeTarget(d, ref, risk, up, lo)
                if (entry - stp) * d > 0 and (tgt - entry) * d > 0
                    sOn    := true
                    sD     := d
                    sKind  := 0
                    sE     := entry
                    sS     := stp
                    sT     := tgt
                    sRisk  := risk
                    sLimit := fadeEntry == "Touch"
                    break
if sOn
    inTr   := true
    trD    := sD
    trKind := sKind
    trE    := sE
    trS    := sS
    trT    := sT
    trRisk := sRisk
    float sRef = sS + sD * sRisk                      // planned entry (= entry unless a limit gap-filled)
    trT1   := sRef + sD * tp1RR * sRisk
    trT1   := (trT1 - trT) * sD > 0 ? trT : trT1      // TP1 never beyond TP2
    trDone1 := p1 <= 0
    trR    := 0.0
    trBar  := bar_index
    trTime := time
    if liqWarn(trE, trS, trD)
        liqCount += 1
    entered := true
    string kName = sKind == 0 ? "Fade" : sKind == 1 ? "BO" : "Failed BO"
    if showTrades
        label.new(bar_index, sE, kName + (sD == 1 ? " ↑" : " ↓"),
             style = sD == 1 ? label.style_label_up : label.style_label_down,
             color = sKind == 0 ? color.new(color.purple, 10) : sKind == 1 ? color.new(color.blue, 10) : color.new(color.fuchsia, 10),
             textcolor = color.white, size = size.tiny)
    alert("Megaphone " + kName + " " + (sD == 1 ? "LONG" : "SHORT") + " on " + syminfo.ticker +
         " | entry " + str.tostring(sE, format.mintick) + " | stop " + str.tostring(sS, format.mintick) +
         " | TP1 " + str.tostring(trT1, format.mintick) + " | TP2 " + str.tostring(sT, format.mintick), alert.freq_once_per_bar)
    if sLimit and (sD == 1 ? low <= sS : high >= sS)       // limit filled, then stopped in the same bar
        exitLabel(sS, "SL", recordExit(trD, trKind, trD * (sS - trE) / trRisk - costR(trD, trE, trRisk, false, time)))
        inTr := false
    sOn := false
bool faded = entered

// 2b) Breakout close → enter now (Close mode) and/or arm the retest / failed-breakout watchers
bool justBroke = false
if live
    int brk = close > up + brkAtr * atrV ? 1 : close < lo - brkAtr * atrV ? -1 : 0
    if brk != 0
        float ln     = brk == 1 ? up : lo
        float height = up - lo
        if doBrk and boEntry == "Close" and not inTr and not faded and sideOk(brk) and trendOk(brk)
            float stp  = ln - brk * stopAtr * atrV
            float risk = math.abs(close - stp)
            float tgt  = close + brk * (boTarget == "R:R" ? rr * risk : height)
            if risk > 0 and (close - stp) * brk > 0 and (tgt - close) * brk > 0
                sOn    := true
                sD     := brk
                sKind  := 1
                sE     := close
                sS     := stp
                sT     := tgt
                sRisk  := risk
                sLimit := false
        patState    := 1
        boDir       := brk
        boBar       := bar_index
        boExt       := brk == 1 ? high : low
        boHeight    := height
        retestArmed := doBrk and boEntry == "Retest"
        fbArmed     := failedBo
        justBroke   := true

// 2c) Broken pattern: retest of the broken line, failed-breakout fade
if patOn and haveAtr and patState == 1 and not justBroke
    int   d   = boDir
    float ln  = d == 1 ? up : lo
    int   age = bar_index - boBar
    boExt := d == 1 ? math.max(boExt, high) : math.min(boExt, low)
    if retestArmed
        if age > retestWin
            retestArmed := false
        else if canEnter
            float zone = ln + d * zoneAtr * atrV
            float stp  = ln - d * stopAtr * atrV
            if d == 1 ? low <= zone : high >= zone
                retestArmed := false                  // one try
                if sideOk(d) and trendOk(d)
                    float e    = d == 1 ? math.min(open, zone) : math.max(open, zone)
                    float risk = math.abs(zone - stp)
                    float tgt  = zone + d * (boTarget == "R:R" ? rr * risk : boHeight)
                    if risk > 0 and (e - stp) * d > 0 and (tgt - e) * d > 0
                        sOn    := true
                        sD     := d
                        sKind  := 1
                        sE     := e
                        sS     := stp
                        sT     := tgt
                        sRisk  := risk
                        sLimit := true
        if retestArmed and (close - (ln - d * stopAtr * atrV)) * d < 0
            retestArmed := false                      // closed back through the stop level: breakout failed
    if fbArmed
        if age > fbWin
            fbArmed := false
        else if d == 1 ? close < ln : close > ln      // closed back inside the megaphone
            fbArmed := false
            int fd = -d
            if not inTr and not sOn and sideOk(fd) and trendOk(fd)
                float stp  = boExt + d * 0.2 * atrV
                float risk = math.abs(close - stp)
                float tgt  = fadeTarget(fd, close, risk, up, lo)
                if risk > 0 and (close - stp) * fd > 0 and (tgt - close) * fd > 0
                    sOn    := true
                    sD     := fd
                    sKind  := 2
                    sE     := close
                    sS     := stp
                    sT     := tgt
                    sRisk  := risk
                    sLimit := false
    if not retestArmed and not fbArmed
        patOn := false
// a pattern broken with nothing left to watch is finished
if patOn and patState == 1 and justBroke and not retestArmed and not fbArmed
    patOn := false

if sOn
    inTr   := true
    trD    := sD
    trKind := sKind
    trE    := sE
    trS    := sS
    trT    := sT
    trRisk := sRisk
    float sRef = sS + sD * sRisk                      // planned entry (= entry unless a limit gap-filled)
    trT1   := sRef + sD * tp1RR * sRisk
    trT1   := (trT1 - trT) * sD > 0 ? trT : trT1      // TP1 never beyond TP2
    trDone1 := p1 <= 0
    trR    := 0.0
    trBar  := bar_index
    trTime := time
    if liqWarn(trE, trS, trD)
        liqCount += 1
    entered := true
    string kName = sKind == 0 ? "Fade" : sKind == 1 ? "BO" : "Failed BO"
    if showTrades
        label.new(bar_index, sE, kName + (sD == 1 ? " ↑" : " ↓"),
             style = sD == 1 ? label.style_label_up : label.style_label_down,
             color = sKind == 0 ? color.new(color.purple, 10) : sKind == 1 ? color.new(color.blue, 10) : color.new(color.fuchsia, 10),
             textcolor = color.white, size = size.tiny)
    alert("Megaphone " + kName + " " + (sD == 1 ? "LONG" : "SHORT") + " on " + syminfo.ticker +
         " | entry " + str.tostring(sE, format.mintick) + " | stop " + str.tostring(sS, format.mintick) +
         " | TP1 " + str.tostring(trT1, format.mintick) + " | TP2 " + str.tostring(sT, format.mintick), alert.freq_once_per_bar)
    if sLimit and (sD == 1 ? low <= sS : high >= sS)       // limit filled, then stopped in the same bar
        exitLabel(sS, "SL", recordExit(trD, trKind, trD * (sS - trE) / trRisk - costR(trD, trE, trRisk, false, time)))
        inTr := false
    sOn := false

// ───────────────────────────── Plots ─────────────────────────────
plot(inTr ? trS : na, "Stop",   color.red,   1, plot.style_linebr)
plot(inTr and p1 > 0 and not trDone1 ? trT1 : na, "TP1", color.green, 1, plot.style_linebr)
plot(inTr and p1 < 1 ? trT : na, "TP2", color.teal, 2, plot.style_linebr)

// ─────────────────────────── Stats table ───────────────────────────
tblPos = switch tblPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    "Middle right" => position.middle_right
    => position.top_right
tblSize = switch tblSizeIn
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table tbl = table.new(tblPos, 5, 15, bgcolor = color.new(color.black, 15),
     border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.gray, frame_width = 1)

cellTxt(int c, int r, string txt, color tc = color.white, color bg = na) =>
    table.cell(tbl, c, r, txt, text_color = tc, text_size = tblSize, bgcolor = bg,
         text_halign = c == 0 ? text.align_left : text.align_center)

sumSet(array<float> a, array<int> ids) =>
    float s = 0.0
    for ix in ids
        s += array.get(a, ix)
    s

fmtR(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "#.##") + "R"
colR(float v) => v > 0 ? color.lime : v < 0 ? color.red : color.white
fmtWR(float w, float l) => w + l > 0 ? str.tostring(w / (w + l) * 100.0, "#.#") + "%" : "–"
fmtPF(float gw, float gl) => gl > 0 ? str.tostring(gw / gl, "#.##") : gw > 0 ? "∞" : "–"

writeCol(int col, array<int> ids, array<int> longIds, array<int> shortIds) =>
    float w  = sumSet(aWins, ids)
    float l  = sumSet(aLoss, ids)
    float r  = sumSet(aSumR, ids)
    float n  = w + l
    float rl = sumSet(aSumR, longIds)
    float rs = sumSet(aSumR, shortIds)
    cellTxt(col, 2, str.tostring(n, "#"))
    cellTxt(col, 3, str.tostring(w, "#") + " / " + str.tostring(l, "#"))
    cellTxt(col, 4, fmtWR(w, l))
    cellTxt(col, 5, fmtR(r), colR(r))
    cellTxt(col, 6, n > 0 ? fmtR(r / n) : "–", colR(r))
    cellTxt(col, 7, fmtPF(sumSet(aGW, ids), sumSet(aGL, ids)))
    cellTxt(col, 8, fmtR(rl), colR(rl))
    cellTxt(col, 9, fmtR(rs), colR(rs))

if barstate.isfirst
    table.merge_cells(tbl, 0, 0, 4, 0)
    for row = 10 to 13
        table.merge_cells(tbl, 1, row, 4, row)

if barstate.islast
    string cfg = str.tostring(minPivots) + " swings" + (minExpAtr > 0 ? " | expand " + str.tostring(minExpAtr) + " ATR" : "") +
         (fitAtr > 0 ? " | fit " + str.tostring(fitAtr) + " ATR" : "") +
         (doFade ? " | fade: " + fadeEntry + " → " + fadeTgt : "") +
         (doBrk ? " | BO: " + boEntry + " → " + boTarget : "") + (failedBo ? " | failed-BO fade" : "") +
         " | TP1 " + str.tostring(tp1RR, "#.##") + "R (" + str.tostring(tp1Pct) + "%) / TP2 " + str.tostring(tp2RR, "#.##") + "R" + (beOn ? " BE" : "") + (trendOn ? " | SMA" + str.tostring(trendLen) : "")
    cellTxt(0, 0, "Megaphone v1.3 — Historical Performance  (" + cfg + (feesOn ? " | net of fees" : " | before fees") + ")", color.white, color.new(color.orange, 40))
    cellTxt(0, 1, "Metric", color.silver)
    cellTxt(1, 1, "Edge fade", color.silver)
    cellTxt(2, 1, "Breakout", color.silver)
    cellTxt(3, 1, "Failed BO", color.silver)
    cellTxt(4, 1, "Total", color.silver)
    cellTxt(0, 2, "Trades")
    cellTxt(0, 3, "Wins / Losses")
    cellTxt(0, 4, "Win rate")
    cellTxt(0, 5, "Net R")
    cellTxt(0, 6, "Avg R / trade")
    cellTxt(0, 7, "Profit factor")
    cellTxt(0, 8, "Long net R")
    cellTxt(0, 9, "Short net R")
    writeCol(1, array.from(0, 1), array.from(0), array.from(1))
    writeCol(2, array.from(2, 3), array.from(2), array.from(3))
    writeCol(3, array.from(4, 5), array.from(4), array.from(5))
    writeCol(4, array.from(0, 1, 2, 3, 4, 5), array.from(0, 2, 4), array.from(1, 3, 5))
    cellTxt(0, 10, "Megaphones detected")
    cellTxt(1, 10, str.tostring(patCount))
    cellTxt(0, 11, "Max drawdown")
    cellTxt(1, 11, "-" + str.tostring(array.get(eq, 2), "#.##") + "R", array.get(eq, 2) > 0 ? color.orange : color.white)
    string cur = inTr ? (trD == 1 ? "LONG " : "SHORT ") + (trKind == 0 ? "edge fade" : trKind == 1 ? "breakout" : "failed-BO fade") + " | stop " +
         str.tostring(trS, format.mintick) + (trDone1 and p1 > 0 ? " (TP1 hit)" : " | TP1 " + str.tostring(trT1, format.mintick)) + " | TP2 " + str.tostring(trT, format.mintick) :
         patOn ? (patState == 0 ? "Megaphone live — watching edges" : "Broken — watching for retest / failure") : "Flat"
    cellTxt(0, 12, "Current")
    cellTxt(1, 12, cur, inTr ? (trD == 1 ? color.lime : color.red) : color.white)
    cellTxt(0, 13, "Liquidation risk @ " + str.tostring(leverage) + "x")
    cellTxt(1, 13, str.tostring(liqCount) + " trades had a stop beyond ~" + str.tostring(liqDistPct, "#.##") + "%", liqCount > 0 ? color.orange : color.white)
